# Rendered infographic PNGs are produced locally into ucl/output (git-ignored);
# the tracked, published copies live in ucl_png/.
ucl/output/

# Internal scraper cookie / matchCentre caches
ucl/matches/**/match_*_cache.json

# Private configuration / credentials
.env

# Local Claude Code config (preview launch.json + machine-local settings)
.claude/

# Python caching
__pycache__/
*.py[cod]

# Model artifact backups (kept local for rollback, e.g. xg_core/xa_artifact.json.bak)
*.bak

# Local virtual environments
venv/
.venv/
env/

# Logs
*.log

# Raw WhoScored match JSONs are huge (~2MB each); the dashboard uses the derived
# ucl_dashboard/matches_detail/*.js instead. Keep raw scrapes local only.
ucl/matches/20*/*.json
# Scratch id lists written by the resilient scraper (harvest cache / gap-fill candidates)
ucl/matches/**/_*.txt
ucl_dashboard/matches_detail/.calibrated
